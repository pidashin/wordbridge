# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Prisma/SQLite database connection string.
DATABASE_URL=file:./dev.db

# Hugging Face Inference API key, used for AI template generation and
# translation regeneration.
HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# Optional overrides for where seed data / flags are read from and written to.
# Defaults to files under app/api/graphql/ when unset.
# WORDS_JSON_PATH=/app/data/words.json
# WORDS_AI_JSON_PATH=/app/data/words_ai.json
# WORD_FLAGS_JSON_PATH=/app/data/word_flags.json
